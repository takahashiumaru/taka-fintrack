{
  "name": "taka-fintrack",
  "version": "1.0.0",
  "description": "Responsive frontend MVP for Taka FinTrack.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "mobile:sync": "cap sync",
    "mobile:assets": "capacitor-assets generate --iconBackgroundColor \"#0B172A\" --splashBackgroundColor \"#F4F9FF\" && cap sync",
    "android:open": "cap open android",
    "android:build:debug": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "ios:open": "cap open ios",
    "ios:sync": "cap sync ios",
    "health-check": "node scripts/health-check.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/share": "^8.0.1",
    "@google/generative-ai": "^0.24.1",
    "@types/pdfkit": "^0.17.6",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "mysql2": "^3.22.3",
    "next": "^14.2.35",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/node": "^20.17.16",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
